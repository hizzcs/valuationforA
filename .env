# A股绝对估值系统 - 生产环境配置
# 请在此设置你的环境变量

# TuShare Pro API Token
# 获取地址: https://tushare.pro
TUSHARE_TOKEN=

# 生产环境配置
DEBUG=False
LOG_LEVEL=INFO

# 数据库配置
DUCKDB_PATH=./duckdb/valuation.duckdb

# 缓存配置
CACHE_DIR=./cache
CACHE_EXPIRY=3600

# 报告配置
REPORT_DIR=./reports

# 邮件通知配置 (可选)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Slack通知配置 (可选)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#valuation
